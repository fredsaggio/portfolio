---
import { Picture } from 'astro:assets';
import photo from '../assets/fred.jpg';
import Icon from './Icon.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations, getProfile } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = getProfile(lang);
const [first, ...rest] = p.name.split(' ');
const last = rest.join(' ');

---

<section class="hero shell" id="inicio">
  <div class="grid">
    <div class="copy">
      <!-- o nome é digitado letra por letra na abertura; leitores de tela recebem o nome inteiro -->
      <h1 class="name" aria-label={p.name}>
        <span class="first" aria-hidden="true">{[...first].map((c, i) => <span class="ch" data-pause={i === first.length - 1 ? '' : undefined}>{c}</span>)}</span>
        <span class="last" aria-hidden="true">{[...last].map((c) => <span class="ch">{c}</span>)}</span>
      </h1>

      <p class="title" data-reveal data-hold style="--i:3"><span class="rule" aria-hidden="true"></span>{p.title}</p>

      <p class="intro" data-reveal data-hold style="--i:4">{p.intro}</p>

      <ul class="stack" data-reveal data-hold style="--i:5">
        {p.heroStack.map((s) => <li>{s}</li>)}
      </ul>

      <div class="ctas" data-reveal data-hold style="--i:6">
        <a class="btn btn-accent" href="#projetos">{t('hero.cta.primary')}<Icon name="arrow-down" class="down" /></a>
        <a class="text-link" href="#contato">{t('hero.cta.contact')}<Icon name="arrow-up-right" /></a>
      </div>
    </div>

    <figure class="portrait" data-reveal style="--i:3">
      <div class="photo">
        <Picture
          src={photo}
          formats={['avif', 'webp']}
          widths={[400, 600, 800, 1000, 1200]}
          quality={85}
          sizes="(min-width: 1024px) 384px, (min-width: 640px) 384px, 90vw"
          alt={t('hero.photoAlt')}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption class="note">
        <Icon name="arrow-up-right" size={20} />
        <span>{p.photoNote}</span>
      </figcaption>
    </figure>
  </div>

</section>

<style>
  .hero { padding-top: clamp(128px, 15vw, 176px); padding-bottom: clamp(48px, 7vw, 80px); }

  .grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.75fr); gap: clamp(40px, 6vw, 64px); align-items: center; }
  .copy { min-width: 0; }

  @keyframes blink { 50% { opacity: 0; } }

  /* abertura: enquanto o nome é digitado, as letras ainda não digitadas e o resto do texto ficam escondidos.
     .hero-done (no <html>) é uma garantia: se o script falhar, tudo aparece depois de alguns segundos. */
  .ch { position: relative; }
  :global(.js-motion:not(.hero-done)) .hero:not(.typed) .ch:not(.on) { visibility: hidden; }
  /* depois que o script assume, só ele decide quais letras aparecem (o nome é apagado e redigitado em loop) */
  :global(.js-motion) .hero[data-typing] .ch:not(.on) { visibility: hidden; }
  :global(.js-motion:not(.hero-done)) .hero:not(.typed) [data-hold] { opacity: 0 !important; translate: 0 40px !important; filter: blur(4px) !important; }
  /* entrada da hero mais curta que a das outras seções: quem chega no site vê o cargo e o texto em menos de 1 s */
  :global(.js-motion) .hero [data-hold] { transition-duration: 0.6s; transition-delay: calc((var(--i, 3) - 3) * 70ms); }
  .ch.cur::after {
    content: ''; position: absolute; right: -0.14em; bottom: 0.1em; width: 0.07em; height: 0.8em;
    background: var(--accent-text); animation: blink 0.9s steps(1) infinite;
  }

  .name { display: grid; font-size: clamp(3rem, 1.2rem + 6.6vw, 6.6rem); font-weight: 500; line-height: 0.95; letter-spacing: -0.065em; }
  .last { padding-left: clamp(0px, 6vw, 96px); }

  .title { display: flex; align-items: center; gap: 16px; margin-top: 32px; font-size: clamp(18px, 1rem + 0.6vw, 24px); font-weight: 500; letter-spacing: -0.02em; }
  .rule { width: 40px; height: 2px; background: var(--accent-text); flex: none; }
  .intro { margin-top: 20px; max-width: 36rem; font-size: clamp(16px, 0.9rem + 0.3vw, 18px); line-height: 1.8; color: var(--muted); }

  .stack { list-style: none; padding: 0; margin-top: 24px; display: flex; flex-wrap: wrap; gap: 8px; }
  .stack li {
    display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px; border-radius: 6px;
    font-size: 13px; font-weight: 500; background: var(--surface-2); border: 1px solid var(--border);
  }
  .stack li::before { content: ''; width: 6px; height: 6px; border-radius: 2px; background: var(--accent-text); }

  .ctas { margin-top: 36px; display: flex; flex-wrap: wrap; align-items: center; gap: 24px; }

  .portrait { position: relative; width: 100%; max-width: 384px; margin: 16px auto 0; }
  .photo { position: relative; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 40px; background: var(--surface-2); }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; transition: transform 1.2s var(--ease); }
  .portrait:hover .photo :global(img) { transform: scale(1.02); }
  .note { margin-top: 20px; display: flex; align-items: center; gap: 10px; font-size: 14px; line-height: 1.6; color: var(--muted); }
  .note :global(svg) { color: var(--accent-text); flex: none; }


  @media (max-width: 1023px) {
    .grid { grid-template-columns: 1fr; }
    .portrait { margin-top: 8px; }
  }
</style>

<script>
  // Abertura: o nome é digitado letra por letra e, depois, apagado e redigitado em loop (pausa de 5 s).
  const hero = document.querySelector<HTMLElement>('.hero');
  const chars = Array.from(hero?.querySelectorAll<HTMLElement>('.name .ch') ?? []);
  if (hero && chars.length && document.documentElement.classList.contains('js-motion')) {
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const setCursor = (i: number) => chars.forEach((c, k) => c.classList.toggle('cur', k === i));
    hero.dataset.typing = '';

    const type = async () => {
      for (let i = 0; i < chars.length; i++) {
        chars[i].classList.add('on');
        setCursor(i);
        await wait(chars[i].dataset.pause !== undefined ? 260 : 55 + Math.random() * 45);
      }
    };
    const erase = async () => {
      for (let i = chars.length - 1; i >= 0; i--) {
        chars[i].classList.remove('on');
        setCursor(i - 1);
        await wait(35);
      }
    };

    (async () => {
      // o resto da hero (cargo, texto, botões) entra logo, enquanto o nome ainda é digitado
      setTimeout(() => hero.classList.add('typed'), 250);
      await wait(400);
      await type();
      for (;;) {
        await wait(5000);
        await erase();
        await wait(450);
        await type();
      }
    })();
  }
</script>
