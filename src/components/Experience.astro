---
import type { Lang } from '../i18n/ui';
import { useTranslations, getProfile } from '../i18n/ui';

/** Linha do tempo horizontal: um traço com uma bolinha por empresa, da mais antiga para a atual. */
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = getProfile(lang);
---

<section class="section shell" id="experiencia" aria-labelledby="exp-title">
  <div class="section-head" data-reveal>
    <p class="eyebrow">{t('exp.eyebrow')}</p>
    <h2 class="section-title" id="exp-title">{t('exp.title')}</h2>
    <p class="section-sub">{t('exp.sub')}</p>
  </div>

  <div class="timeline" style={`--n:${p.experience.length}`}>
    <span class="line" data-reveal aria-hidden="true"></span>
    <ol class="stops">
      {p.experience.map((e, i) => (
        <li class:list={['stop', { current: e.current }]} data-reveal style={`--i:${i + 1}`}>
          <span class="dot" aria-hidden="true"></span>
          <p class="period">{e.period}</p>
          <h3 class="company">{e.company}</h3>
          <p class="role">{e.role}</p>
          <p class="place">{e.place}</p>
          <p class="text">{e.text}</p>
          <ul class="tags">{e.stack.map((s) => <li class="tag">{s}</li>)}</ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline { position: relative; --dot: 16px; }

  /* o traço horizontal passa pelo centro das bolinhas e continua até a borda (a trajetória segue) */
  .line {
    position: absolute; left: 0; right: 0; top: calc(var(--dot) / 2 - 1px); height: 2px;
    background: linear-gradient(90deg, var(--border-strong), var(--accent-text) 70%, transparent);
    transform-origin: left center;
  }
  :global(.js-motion) .line[data-reveal] { opacity: 1; translate: 0 0; filter: none; scale: 0 1; transition: scale 1.4s var(--ease); }
  :global(.js-motion) .line[data-reveal]:global(.is-in) { scale: 1 1; }

  .stops { position: relative; list-style: none; padding: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: clamp(32px, 5vw, 64px); }
  .stop { min-width: 0; }

  .dot {
    position: relative; display: block; width: var(--dot); height: var(--dot); border-radius: 50%;
    background: var(--bg); border: 2px solid var(--accent-text); margin-bottom: 28px;
  }
  .current .dot { background: var(--accent-text); }
  .current .dot::after {
    content: ''; position: absolute; inset: -8px; border-radius: 50%; border: 2px solid var(--accent-text);
    opacity: 0; animation: ping 2.4s var(--ease) infinite;
  }
  @keyframes ping { 0% { transform: scale(0.5); opacity: 0.8; } 80%, 100% { transform: scale(1.4); opacity: 0; } }

  .period { font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--subtle); }
  .company { margin-top: 14px; font-size: clamp(28px, 1.4rem + 1.2vw, 38px); font-weight: 500; letter-spacing: -0.035em; line-height: 1.1; }
  .role { margin-top: 8px; font-size: 15px; font-weight: 500; color: var(--accent-text); }
  .place { margin-top: 4px; font-size: 13px; color: var(--subtle); }
  .text { margin-top: 16px; max-width: 34rem; font-size: 15px; line-height: 1.75; color: var(--muted); }
  .tags { margin-top: 20px; }

  @media (prefers-reduced-motion: reduce) {
    .current .dot::after { animation: none; }
  }

  /* no celular a linha fica vertical, à esquerda */
  @media (max-width: 760px) {
    .line {
      left: calc(var(--dot) / 2 - 1px); right: auto; top: 0; bottom: 0; width: 2px; height: auto;
      background: linear-gradient(180deg, var(--border-strong), var(--accent-text) 70%, transparent);
      transform-origin: center top;
    }
    :global(.js-motion) .line[data-reveal] { scale: 1 0; }
    :global(.js-motion) .line[data-reveal]:global(.is-in) { scale: 1 1; }
    .stops { grid-template-columns: 1fr; gap: 48px; }
    .stop { position: relative; padding-left: calc(var(--dot) + 24px); }
    .dot { position: absolute; left: 0; top: 0; margin: 0; }
    .period { min-height: var(--dot); }
  }
</style>
