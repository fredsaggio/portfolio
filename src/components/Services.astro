---
import Icon from './Icon.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations, getProfile } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = getProfile(lang);
---

<section class="section shell" id="atuacao" aria-labelledby="services-title">
  <div class="section-head" data-reveal>
    <p class="eyebrow">{t('services.eyebrow')}</p>
    <h2 class="section-title" id="services-title">{t('services.title')}</h2>
    <p class="section-sub">{t('services.sub')}</p>
  </div>

  <ol class="rows">
    {p.services.map((s, i) => (
      <li class="row" data-reveal style={`--i:${i}`}>
        <span class="n">{String(i + 1).padStart(2, '0')}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
        <Icon name="arrow-up-right" size={20} class="arrow" />
      </li>
    ))}
  </ol>
</section>

<style>
  .rows { list-style: none; padding: 0; border-bottom: 1px solid var(--border); }
  .row {
    display: grid; grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1.1fr) 24px; gap: 16px 24px; align-items: start;
    padding-block: 36px; border-top: 1px solid var(--border); transition: padding 0.4s var(--ease);
  }
  .n { font-size: 12px; color: var(--accent-text); padding-top: 10px; }
  h3 { font-size: clamp(24px, 1.2rem + 1vw, 30px); font-weight: 400; letter-spacing: -0.03em; line-height: 1.2; transition: transform 0.4s var(--ease); }
  .row p { color: var(--muted); font-size: 14px; line-height: 1.75; padding-top: 6px; }
  .row :global(.arrow) { color: var(--accent-text); margin-top: 8px; transition: transform 0.4s var(--ease); }
  .row:hover h3 { transform: translateX(8px); }
  .row:hover :global(.arrow) { transform: rotate(45deg); }
  @media (max-width: 760px) {
    .row { grid-template-columns: 40px minmax(0, 1fr) 24px; }
    .row p { grid-column: 2 / 4; padding-top: 0; }
  }
</style>
