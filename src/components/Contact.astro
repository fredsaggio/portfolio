---
import Icon from './Icon.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations, getProfile } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = getProfile(lang);
const socials = [
  { label: 'LinkedIn', href: p.links.linkedin, icon: 'linkedin' as const },
  { label: 'GitHub', href: p.links.github, icon: 'github' as const },
];
---

<section class="section shell contact" id="contato" aria-labelledby="contact-title">
  <div class="inner">
    <p class="eyebrow" data-reveal>{t('contact.eyebrow')}</p>
    <h2 class="title" id="contact-title" data-reveal style="--i:1">{t('contact.title')}</h2>
    <span class="rule" aria-hidden="true" data-reveal style="--i:2"></span>
    <p class="text" data-reveal style="--i:2">{t('contact.text')}</p>

    <div class="mail" data-reveal style="--i:3">
      <a class="email" href={`mailto:${p.email}`}>{p.email}</a>
      <button class="copy" type="button" data-copy={p.email} data-done={t('contact.copied')} aria-label={t('contact.copy')}>
        <Icon name="copy" size={16} class="i-copy" /><Icon name="check" size={16} class="i-check" />
        <span class="copy-label" aria-live="polite">{t('contact.copy')}</span>
      </button>
    </div>

    <ul class="socials" data-reveal style="--i:4">
      {socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener">
            <span class="ico"><Icon name={s.icon} size={18} /></span>
            <span class="label">{s.label}</span>
            <span class="go"><Icon name="arrow-up-right" size={14} /></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .contact { padding-top: 0; }
  .inner { border-top: 1px solid var(--border); padding-top: clamp(64px, 8vw, 96px); display: grid; gap: 20px; justify-items: start; }
  .title { font-size: clamp(2.6rem, 1.4rem + 4vw, 4.2rem); font-weight: 400; line-height: 1.05; letter-spacing: -0.045em; max-width: 12ch; margin-top: 8px; }
  .rule { width: 64px; height: 1px; background: var(--border-strong); }
  .text { max-width: 26rem; color: var(--muted); line-height: 1.75; }

  .mail { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 8px; min-width: 0; max-width: 100%; }
  .email {
    font-size: clamp(1.4rem, 0.6rem + 3.4vw, 2.75rem); font-weight: 400; letter-spacing: -0.03em; line-height: 1.2;
    color: var(--accent-text); text-decoration: none; overflow-wrap: anywhere; min-width: 0;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size 0.5s var(--ease);
  }
  .email:hover { background-size: 100% 1px; }
  .copy {
    display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 999px; cursor: pointer;
    background: var(--surface-2); border: 1px solid var(--border-strong); font-size: 13px; font-weight: 500;
  }
  .copy:hover { border-color: var(--subtle); }
  .copy :global(.i-check) { display: none; color: var(--accent-text); }
  .copy.is-done :global(.i-check) { display: block; }
  .copy.is-done :global(.i-copy) { display: none; }

  .socials { list-style: none; padding: 0; margin-top: 20px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; width: 100%; max-width: 760px; }
  .socials a {
    display: flex; align-items: center; gap: 14px; padding: 16px; border-radius: 12px; text-decoration: none;
    border: 1px solid var(--border); background: var(--surface); transition: border-color 0.3s, background-color 0.3s;
  }
  .socials a:hover { border-color: var(--border-strong); background: var(--surface-2); }
  .ico { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 8px; background: var(--surface-3); }
  .label { flex: 1; font-size: 15px; font-weight: 600; }
  .go { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--border-strong); transition: transform 0.3s var(--ease), color 0.2s; }
  .socials a:hover .go { transform: rotate(45deg); color: var(--accent-text); }
  @media (max-width: 520px) { .socials { grid-template-columns: 1fr; } }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('.copy-label')!;
    const original = label.textContent;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        label.textContent = btn.dataset.done!;
        btn.classList.add('is-done');
        setTimeout(() => { label.textContent = original; btn.classList.remove('is-done'); }, 1800);
      } catch {
        const target = btn.previousElementSibling;
        const sel = window.getSelection();
        if (sel && target) { const r = document.createRange(); r.selectNodeContents(target); sel.removeAllRanges(); sel.addRange(r); }
      }
    });
  });
</script>
