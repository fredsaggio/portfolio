  @media (hover: hover) and (pointer: fine) {
    html { cursor: var(--cur-default), auto; }
    :is(a[href], button, summary, label, select, [role='button'], [data-copy]) { cursor: var(--cur-pointer), pointer !important; }
    :is(input:not([type='checkbox'], [type='radio'], [type='button'], [type='submit']), textarea, [contenteditable]) { cursor: var(--cur-text), text !important; }
    :is(button:disabled, .is-private, [aria-disabled='true']) { cursor: var(--cur-blocked), not-allowed !important; }
  }
